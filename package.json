{
  "name": "open-mind-ai",
  "version": "3.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:release": "tauri build",
    "build:microsoft-store": "powershell -ExecutionPolicy Bypass -File scripts/build-microsoft-store-exe.ps1",
    "build:microsoft-store-msix": "powershell -ExecutionPolicy Bypass -File scripts/build-microsoft-store-msix.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "test:image": "node --experimental-strip-types --test tests/imageGeneration.test.mjs",
    "format": "prettier --write .",
    "check:version": "node scripts/check-version-consistency.mjs",
    "check:release": "node scripts/check-release-readiness.mjs",
    "check:models": "node scripts/check-model-catalog.mjs"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "@vitejs/plugin-react": "^6.1.1",
    "highlight.js": "^11.10.0",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "mediabunny": "1.59.1",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.3",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "7.0.2"
  }
}
