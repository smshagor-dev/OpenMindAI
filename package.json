{
  "name": "open-mind-ai",
  "version": "6.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:release": "tauri build",
    "build:microsoft-store": "powershell -ExecutionPolicy Bypass -File scripts/build-microsoft-store-exe.ps1",
    "build:microsoft-store-msix": "powershell -ExecutionPolicy Bypass -File scripts/build-microsoft-store-msix.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "test": "node --test tests",
    "test:chat-routing": "node --test tests/chatModeRouting.test.mjs",
    "test:image": "node --experimental-strip-types --test tests/imageGeneration.test.mjs",
    "test:pdf": "node --test tests/pdfIngestion.test.mjs tests/pdfWorkBudget.test.mjs",
    "test:regeneration": "node --test tests/regeneration.test.mjs",
    "test:model-inventory": "node --test tests/modelInventory.test.mjs",
    "test:model-actions": "node --test tests/modelActions.test.mjs",
    "test:attachments": "node --test tests/attachmentIngestion.test.mjs",
    "test:attachment-context": "node --experimental-strip-types --test tests/attachmentContext.test.mjs",
    "test:settings-save": "node --test tests/settingsSave.test.mjs",
    "test:voice-drafts": "node --test tests/voiceDraft.test.mjs tests/voiceComposer.test.mjs",
    "test:ime": "node --test tests/composerIme.test.mjs",
    "test:drafts": "node --test tests/chatDraft.test.mjs",
    "test:conversations": "node --experimental-strip-types --test tests/conversationState.test.mjs",
    "test:workspace": "node --experimental-strip-types --test tests/workspaceDirectoryGate.test.mjs",
    "test:updates": "node --experimental-strip-types --test tests/updateCoordinator.test.mjs",
    "test:model-updates": "node --test tests/modelUpdates.test.mjs",
    "check:theme": "node --test tests/theme-colors.test.mjs tests/download-surfaces.test.mjs",
    "format": "prettier --write .",
    "check:version": "node scripts/check-version-consistency.mjs",
    "check:release": "node scripts/check-release-readiness.mjs",
    "check:models": "node scripts/check-model-catalog.mjs",
    "test:routing": "node --experimental-strip-types --test tests/executionRouting.test.mjs",
    "test:chat-search": "node --test tests/chatSearchPaging.test.mjs",
    "test:project-catalog": "node --test tests/projectCatalogPaging.test.mjs",
    "test:project-binary": "node --test tests/projectBinaryAttachments.test.mjs",
    "test:backup-scope": "node --experimental-strip-types --test tests/backupScope.test.mjs",
    "test:setup-storage": "node --test tests/setupStorageValidation.test.mjs",
    "test:studio3d": "node --experimental-strip-types --test tests/studio3dMeshRoundtrip.test.mjs tests/studio3dIncrementalEdit.test.mjs"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.3.0",
    "highlight.js": "^11.10.0",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.0",
    "mediabunny": "1.65.2",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "three": "^0.180.0",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.15.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gltf-validator": "^2.0.0-dev.3.10",
    "jsdom": "31.0.0",
    "prettier": "^3.10.1",
    "typescript": "5.9.3"
  }
}
