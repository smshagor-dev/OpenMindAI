{
  "name": "open-mind-ai",
  "version": "4.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:release": "tauri build",
    "build:microsoft-store": "powershell -ExecutionPolicy Bypass -File scripts/build-microsoft-store-exe.ps1",
    "build:microsoft-store-msix": "powershell -ExecutionPolicy Bypass -File scripts/build-microsoft-store-msix.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "test:image": "node --experimental-strip-types --test tests/imageGeneration.test.mjs",
    "test:updates": "node --experimental-strip-types --test tests/updateCoordinator.test.mjs",
    "check:theme": "node --test tests/theme-colors.test.mjs tests/download-surfaces.test.mjs",
    "format": "prettier --write .",
    "check:version": "node scripts/check-version-consistency.mjs",
    "check:release": "node scripts/check-release-readiness.mjs",
    "check:models": "node scripts/check-model-catalog.mjs"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@vitejs/plugin-react": "^6.1.2",
    "highlight.js": "^11.10.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "mediabunny": "1.62.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
