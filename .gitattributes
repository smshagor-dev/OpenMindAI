# Shell/bash scripts must keep LF line endings regardless of the checkout
# platform's core.autocrlf setting -- a CRLF shebang line ("#!/usr/bin/env
# bash\r") fails to execute on Linux/macOS ("bad interpreter" errors).
*.sh text eol=lf
*.command text eol=lf

# Windows-native scripts keep their traditional CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Everything else: let Git normalize text files, but don't force a
# particular ending -- the working platform's default is fine.
* text=auto
