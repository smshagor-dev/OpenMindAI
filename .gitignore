# ==================================================
# OpenMindAI local/runtime data
# NEVER COMMIT THESE
# ==================================================

/models/**
/runtimes/**
/data/**
/cache/**
/temp/**
/logs/**
/generated/**
/workspaces/**
/knowledge/**
/backups/**
/config/**
/app/**

# Legacy/development fallback runtime root.
OpenMindAI/

# ==================================================
# Documentation policy: README.md is the only tracked
# Markdown file. Everything else (docs/, CHANGELOG.md,
# THIRD_PARTY_NOTICES.md, etc.) stays local-only.
# ==================================================
docs/
*.md
!README.md

# Downloaded/built release artifacts and bootstrap scratch space -- never
# commit compiled installers, signatures, checksums, or a bootstrap-cloned
# copy of the source. Release artifacts belong on GitHub Releases.
*.exe
*.msi
*.dmg
*.AppImage
*.sig
SHA256SUMS.txt
/release-output/
/release-download/

# AI models
*.gguf
*.ggml
*.safetensors
*.bin
*.onnx
*.part

# SQLite runtime/user databases
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local environment configuration
.env
.env.local
.env.*.local

# Updater signing keys — NEVER commit a real release signing key.
.updater-dev-key.pem
.updater-dev-key.pem.pub
*.key
*.pem
*.pfx
*.p12

# Runtime/download artifacts
*.zip
*.7z
*.tar
*.tar.gz

# Temporary files
*.tmp
*.temp

# Rust build output
/src-tauri/target/
target/

# Machine-local cargo override (target-dir redirected off exFAT G: — see file comment)
/src-tauri/.cargo/config.toml

# Frontend build output
/dist/
dist/
/src-mobile/build/
/src-mobile/build-clean/
/src-mobile/build-run/
/src-mobile/.dart_tool/
/src-mobile/ios/Flutter/ephemeral/

# Node dependencies
/node_modules/
node_modules/

# Vite cache
.vite/

# Logs
*.log

# OS/editor files
.DS_Store
Thumbs.db
desktop.ini

.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Local AI coding assistant tooling state — not project source.
.claude/

.idea/
