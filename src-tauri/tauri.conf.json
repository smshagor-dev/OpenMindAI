{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMindAI",
  "version": "2.0.0",
  "identifier": "ai.openmind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMindAI",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3MjlGRkJDQURGNjJEMjQKUldRa0xmYXR2UDhwSitNU3RxcHp2TTBmRmVCZlFTSmp4R3VvSytZSmRBRnppZk5xUSs5Q1EyMEQK",
      "endpoints": [
        "https://REPLACE-BEFORE-RELEASE.invalid/openmindai/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
