{
  "name": "openmindai-vscode",
  "displayName": "OpenMindAI",
  "description": "Use your local OpenMindAI assistant from VS Code.",
  "version": "0.1.10",
  "publisher": "openmindai",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "keywords": [
    "openmindai",
    "local ai",
    "coding assistant",
    "llm",
    "offline"
  ],
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onView:openmindai.chatView",
    "onChatParticipant:openmindai.agent",
    "onCommand:openmindai.openChat",
    "onCommand:openmindai.openAgentChat",
    "onCommand:openmindai.startNativeInterface",
    "onCommand:openmindai.stopNativeInterface",
    "onCommand:openmindai.buildNativeInterface",
    "onCommand:openmindai.checkConnection",
    "onCommand:openmindai.ask",
    "onCommand:openmindai.explainSelection",
    "onCommand:openmindai.fixSelection"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"test/*.test.js\"",
    "check": "npm run compile && npm test && npm run package",
    "test:e2e": "npm run compile && node test-e2e/run.js",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/package-vsix.ps1",
    "vscode:prepublish": "npm run compile"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "openmindai",
          "title": "OpenMindAI",
          "icon": "media/openmindai.svg"
        }
      ]
    },
    "views": {
      "openmindai": [
        {
          "type": "webview",
          "id": "openmindai.chatView",
          "name": "OpenMindAI Chat",
          "icon": "media/openmindai.svg"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "openmindai.agent",
        "name": "openmindai",
        "fullName": "OpenMindAI",
        "description": "Ask your local OpenMindAI agent to read, explain, and edit this workspace.",
        "isSticky": true,
        "commands": [
          {
            "name": "edit",
            "description": "Edit files directly in the current workspace."
          },
          {
            "name": "explain",
            "description": "Explain the active file or current selection."
          },
          {
            "name": "audit",
            "description": "Audit the project and report risks."
          }
        ]
      }
    ],
    "configuration": {
      "title": "OpenMindAI",
      "properties": {
        "openmindai.endpoint": {
          "type": "string",
          "default": "auto",
          "description": "Local OpenMindAI API endpoint. Use auto to discover the running desktop runtime port."
        },
        "openmindai.model": {
          "type": "string",
          "default": "openmind-local",
          "description": "Model name sent to the local OpenMindAI chat endpoint."
        },
        "openmindai.requestTimeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 5000,
          "description": "Timeout for one OpenMindAI response. A full 2048-token answer can take a few minutes on CPU or small GPUs. Coding agent model loading is waited for separately and does not count against this."
        },
        "openmindai.maxContextCharacters": {
          "type": "number",
          "default": 800,
          "minimum": 200,
          "maximum": 50000,
          "description": "Maximum active editor context sent with Ask."
        },
        "openmindai.maxOutputTokens": {
          "type": "integer",
          "default": 2048,
          "minimum": 16,
          "maximum": 8192,
          "description": "Maximum response tokens requested from the local OpenMindAI endpoint. Increase it for large file edits or long answers. Invalid values fall back to 2048; the native interface fallback also caps it to half of openmindai.nativeContextSize."
        },
        "openmindai.apiToken": {
          "type": "string",
          "default": "",
          "description": "Optional bearer token for a protected local OpenMindAI endpoint."
        },
        "openmindai.autoStartNativeInterface": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the fallback local native interface when no desktop OpenMindAI runtime is running."
        },
        "openmindai.nativeInterfaceRoot": {
          "type": "string",
          "default": "",
          "description": "OpenMindAI source or install root used to start the native interface. Empty means auto-detect from the current workspace."
        },
        "openmindai.nativeModelPath": {
          "type": "string",
          "default": "",
          "description": "Absolute GGUF model path for the native interface registry. Empty means auto-detect a local GGUF model."
        },
        "openmindai.nativeGpuLayers": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 999,
          "description": "GPU layers for the native interface model registry."
        },
        "openmindai.nativeContextSize": {
          "type": "number",
          "default": 1024,
          "minimum": 512,
          "maximum": 32768,
          "description": "Context size for the native interface model registry."
        }
      }
    },
    "commands": [
      {
        "command": "openmindai.openChat",
        "title": "OpenMindAI: Open Right-Side Chat"
      },
      {
        "command": "openmindai.openAgentChat",
        "title": "OpenMindAI: Open Native Chat Participant"
      },
      {
        "command": "openmindai.startNativeInterface",
        "title": "OpenMindAI: Start Native Interface"
      },
      {
        "command": "openmindai.stopNativeInterface",
        "title": "OpenMindAI: Stop Native Interface"
      },
      {
        "command": "openmindai.buildNativeInterface",
        "title": "OpenMindAI: Build Native Interface"
      },
      {
        "command": "openmindai.checkConnection",
        "title": "OpenMindAI: Check Local Connection"
      },
      {
        "command": "openmindai.ask",
        "title": "OpenMindAI: Ask"
      },
      {
        "command": "openmindai.explainSelection",
        "title": "OpenMindAI: Explain Selection"
      },
      {
        "command": "openmindai.fixSelection",
        "title": "OpenMindAI: Fix Selection"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "openmindai.openChat"
        },
        {
          "command": "openmindai.openAgentChat"
        },
        {
          "command": "openmindai.startNativeInterface"
        },
        {
          "command": "openmindai.stopNativeInterface"
        },
        {
          "command": "openmindai.buildNativeInterface"
        },
        {
          "command": "openmindai.checkConnection"
        },
        {
          "command": "openmindai.ask"
        },
        {
          "command": "openmindai.explainSelection"
        },
        {
          "command": "openmindai.fixSelection"
        }
      ],
      "editor/context": [
        {
          "command": "openmindai.explainSelection",
          "when": "editorHasSelection",
          "group": "openmindai@1"
        },
        {
          "command": "openmindai.fixSelection",
          "when": "editorHasSelection",
          "group": "openmindai@2"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.92.0",
    "typescript": "5.9.3"
  }
}
